{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@game/*": [
        "src/slots/empireofgold/*",
        "src/slots/royale81/*",
        "src/slots/empireofgoldnewconquest/*",
        "src/slots/sweetsalon/*"
      ],
      "@assets/*": [
        "../feg_games_assets/empireofgold/*",
        "../feg_games_assets/royale81/*",
        "../feg_games_assets/empireofgoldnewconquest/*",
        "../feg_games_assets/sweetsalon/*"
      ],
      "@common/*": [
        "../feg_games_assets/common/*"
      ],
      "@core/*": [
        "src/corelib/*"
      ],
      "@brand/*": [
        "src/brandlib/*"
      ],
      "@slots/*": [
        "src/slots/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@commonAssets/*": [
        "commonAssets/*"
      ],
    },
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "Node",
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "preserveSymlinks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "../feg_games_src/src"
  ],
  "exclude": [
    "node_modules/**"
  ]
}
