{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.js",
      "/*.js.gz",
      "/*.js.br",
      "/*.css",
      "/*.css.gz",
      "/*.css.br",
      "/*.json",
      "/*.wasm",
      "/*.png",
      "/*.jpg",
      "/*.webp",
      "/*.svg",
      "/*.ico",
      "/*.ttf",
      "/*.woff",
      "/*.woff2",
      "/sounds/*",
      "/spines/*",
      "/images/*",
      "/fonts/*",
      "/panel/*",
      "/locale/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sounds/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/spines/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/fonts/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/common/env/commonConfig.json",
      "headers": {
        "Cache-Control": "no-store, no-cache"
      }
    },
    {
      "route": "/staticwebapp.config.json",
      "headers": {
        "Cache-Control": "no-store, no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".br": "identity",
    ".gz": "identity"
  }
}
